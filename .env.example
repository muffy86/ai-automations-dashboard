# --- Direct mode (local dev) ---
# Point the browser straight at the Nucleus backend
NEXT_PUBLIC_NUCLEUS_URL=http://localhost:8080

# --- Proxy mode (Vercel / production) ---
# Set NEXT_PUBLIC_NUCLEUS_URL to /api/nucleus so the browser hits
# the Next.js proxy route, which forwards to NUCLEUS_URL server-side.
# This keeps the Nucleus backend off the public internet.
#
# NEXT_PUBLIC_NUCLEUS_URL=/api/nucleus
# NUCLEUS_URL=http://your-private-nucleus-host:8080
NUCLEUS_URL=http://localhost:8080
